# === Telegram API credentials (my.telegram.org) ===
API_ID=
API_HASH=

# === Bot token (from @BotFather) ===
BOT_TOKEN=

# === MongoDB ===
MONGO_URI=
DATABASE_NAME=triss

# === Owner ===
# Numeric Telegram user ID of the single bot owner (get it from @userinfobot)
OWNER_ID=

# === Storage / Logging ===
# Numeric ID of the private channel used as internal storage.
# Can be left blank and configured later via /settings -> Store Channel.
STORAGE_CHANNEL_ID=

# Numeric ID of a channel/group to receive owner-facing logs (optional).
LOG_CHANNEL_ID=

# === Optional ===
# Port for the health-check web server (Railway/Render set this
# automatically). Not used for Shortener verification — that happens
# entirely inside Telegram, no public URL required.
PORT=8080

# Secret used to sign/verify one-time shortener verification proofs.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a value is derived from BOT_TOKEN at startup (logged as a
# warning) so the bot still runs, but setting this explicitly is strongly
# recommended in production.
VERIFICATION_SECRET=
